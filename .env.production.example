SPRING_PROFILES_ACTIVE=prod
MYSQL_DATABASE=blog_app_apis
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
DB_URL=jdbc:mysql://mysql:3306/blog_app_apis?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=blog_user
DB_PASSWORD=replace-with-strong-application-password
IDENTITY_MYSQL_DATABASE=blog_identity
IDENTITY_MYSQL_PORT=3307
IDENTITY_MYSQL_ROOT_PASSWORD=replace-with-strong-identity-root-password
IDENTITY_DB_URL=jdbc:mysql://identity-mysql:3306/blog_identity?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
IDENTITY_DB_USERNAME=identity_user
IDENTITY_DB_PASSWORD=replace-with-strong-identity-password
POST_MYSQL_DATABASE=blog_posts
POST_MYSQL_PORT=3308
POST_MYSQL_ROOT_PASSWORD=replace-with-strong-post-root-password
POST_DB_URL=jdbc:mysql://post-mysql:3306/blog_posts?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
POST_DB_USERNAME=post_user
POST_DB_PASSWORD=replace-with-strong-post-password
GATEWAY_PORT=9090
BACKEND_BASE_URL=http://backend:9090
IDENTITY_BASE_URL=http://identity-service:9092
POST_SERVICE_BASE_URL=http://post-service:9093
CATEGORY_SERVICE_BASE_URL=http://backend:9090
JWT_SECRET=replace-with-a-long-random-secret-at-least-64-characters-long
INTERNAL_SERVICE_TOKEN=replace-with-a-separate-long-random-internal-service-token
JWT_EXPIRATION_MS=18000000
CORS_ALLOWED_ORIGINS=https://your-domain.com
