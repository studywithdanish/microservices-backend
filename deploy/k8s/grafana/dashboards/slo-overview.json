    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Availability budget consumption speed. A value of 1 is sustainable; 14.4 is the fast-burn paging threshold.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "Burn rate", "axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 12, "lineInterpolation": "linear", "lineWidth": 2, "pointSize": 5, "showPoints": "never", "spanNulls": false, "stacking": { "group": "A", "mode": "none" } },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 14.4 }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 5,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "blog:slo_http_errors:ratio5m{application=\"$application\"} / 0.005", "legendFormat": "5m burn", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "blog:slo_http_errors:ratio1h{application=\"$application\"} / 0.005", "legendFormat": "1h burn", "range": true, "refId": "B" },
        { "editorMode": "code", "expr": "blog:slo_http_errors:ratio6h{application=\"$application\"} / 0.005", "legendFormat": "6h burn", "range": true, "refId": "C" }
      ],
      "title": "Availability Error-Budget Burn Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Latency budget consumption speed for requests slower than two seconds.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "Burn rate", "axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 12, "lineInterpolation": "linear", "lineWidth": 2, "pointSize": 5, "showPoints": "never", "spanNulls": false, "stacking": { "group": "A", "mode": "none" } },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 14.4 }] },
