      "targets": [{ "editorMode": "code", "expr": "sum(ALERTS{alertstate=\"firing\",service=\"$application\",slo=~\"availability|latency\"}) or vector(0)", "instant": true, "legendFormat": "Firing SLO alerts", "range": false, "refId": "A" }],
