{{ define "blog.email.subject" -}}
[{{ .Status | toUpper }}][{{ .CommonLabels.severity | toUpper }}] {{ .CommonLabels.alertname }}
{{- end }}

{{ define "blog.email.text" -}}
Blog Platform alert group is {{ .Status }}.

Team: {{ .CommonLabels.team }}
Severity: {{ .CommonLabels.severity }}
Service: {{ or .CommonLabels.service .CommonLabels.application }}

{{ range .Alerts -}}
- {{ .Annotations.summary }}
  {{ .Annotations.description }}
  Runbook: {{ .Annotations.runbook }}
{{ end }}
{{- end }}

{{ define "blog.email.html" -}}
<!doctype html>
<html lang="en">
  <body style="font-family: Arial, sans-serif; color: #1f2937;">
    <h2>Blog Platform alert: {{ .Status | toUpper }}</h2>
    <p>
      <strong>Team:</strong> {{ .CommonLabels.team }}<br>
      <strong>Severity:</strong> {{ .CommonLabels.severity }}<br>
      <strong>Service:</strong> {{ or .CommonLabels.service .CommonLabels.application }}
    </p>
    {{ range .Alerts }}
    <div style="border-left: 4px solid #dc2626; margin: 16px 0; padding: 8px 16px;">
      <h3>{{ .Annotations.summary }}</h3>
      <p>{{ .Annotations.description }}</p>
      <p><strong>Runbook:</strong> {{ .Annotations.runbook }}</p>
      <p><strong>Started:</strong> {{ .StartsAt }}</p>
    </div>
    {{ end }}
  </body>
</html>
{{- end }}
