{
  "policy": {
    "_meta": {
      "description": "Retain Blog Platform application logs for 14 days"
    },
    "phases": {
      "hot": {
        "min_age": "0ms",
        "actions": {}
      },
      "delete": {
        "min_age": "14d",
        "actions": {
          "delete": {}
        }
      }
    }
  }
}
